# OCI Provider Configuration
tenancy_ocid     = "ocid1.tenancy.oc1..example"
user_ocid        = "ocid1.user.oc1..example"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..example"

# Network Configuration
vcn_cidr_block      = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
db_subnet_cidr      = "10.0.3.0/24"

# SSH Access Configuration
# SECURITY: Restrict SSH access to bastion host to specific IPs for production
# Examples:
# - Your IP: ["1.2.3.4/32"]
# - Corporate network: ["10.20.0.0/16", "192.168.1.0/24"]
# - Any IP (NOT recommended for production): ["0.0.0.0/0"]
ssh_allowed_cidrs = ["0.0.0.0/0"]  # Change this to your IP or network for better security

# Compute Configuration (Always Free Compatible - Arm-based)
# For Always Free: Use VM.Standard.A1.Flex with up to 4 OCPUs and 24 GB RAM total across all instances
# Alternative: VM.Standard.E2.1.Micro (AMD, 1 OCPU, 1 GB RAM, max 2 instances)
instance_shape          = "VM.Standard.A1.Flex"  # Arm-based Always Free shape
instance_ocpus          = 1  # 1 OCPU per instance (max 4 total)
instance_memory_in_gbs  = 6  # 6 GB per instance (max 24 GB total)
instance_count          = 2  # Up to 4 instances allowed
ssh_public_key          = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC..."
instance_image_ocid     = "" # Leave empty to use latest Oracle Linux 8 (Arm-compatible)
availability_domain     = "ABCD:US-ASHBURN-AD-1"

# Bastion Configuration (Always Free Compatible)
# Bastion host provides SSH access to backend instances in private subnet
bastion_shape         = "VM.Standard.A1.Flex"  # Arm-based Always Free shape
bastion_ocpus         = 1  # 1 OCPU
bastion_memory_in_gbs = 1  # 1 GB RAM

# Database Configuration (Always Free - automatically configured)
# The database module uses Always Free tier with:
# - 1 OCPU (automatic)
# - 20 GB storage (automatic)
# - Public endpoint only (no VCN integration)
adb_display_name   = "anonymouswall-adb"
adb_db_name        = "ANONWALLDB"
adb_admin_password = "YOUR_STRONG_PASSWORD_HERE"  # Must be 12-30 chars with uppercase, lowercase, numbers, and special chars
adb_db_version     = "19c"
adb_db_workload    = "OLTP"

# Testing Database Configuration (Same as above, but for testing)
adb_testing_display_name   = "anonymouswall-adb-testing"
adb_testing_db_name        = "ANONWALLTEST"
adb_testing_admin_password = "YOUR_TESTING_PASSWORD_HERE"  # Use a different password for testing

# The following database parameters are not used in Always Free tier but kept for backward compatibility
adb_cpu_core_count          = 1
adb_data_storage_size_in_tbs = 1
adb_license_model           = "LICENSE_INCLUDED"

# Load Balancer Configuration (Always Free Compatible)
# Always Free: 1 load balancer with 10 Mbps fixed bandwidth
lb_shape              = "flexible"
lb_min_bandwidth_mbps = 10  # Always Free minimum
lb_max_bandwidth_mbps = 10  # Always Free maximum (set to 10 for Always Free, or higher for paid tier)

# DNS Configuration (Optional - leave empty to skip DNS setup)
dns_zone_name    = "" # e.g., "example.com"
dns_record_domain = "" # e.g., "api.example.com" or leave empty to use zone_name

# General Configuration
app_name    = "anonymouswall"
environment = "prod"

# Tags
tags = {
  Application = "AnonymousWall"
  ManagedBy   = "Terraform"
  Environment = "Production"
}

